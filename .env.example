# Local development only. Copy this file to .env in the repository root.
# FastAPI reads these values locally; Docker Compose passes them to containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=read_analyzer

BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Useful for Docker Desktop / WSL bind mounts where file events are not forwarded.
WATCHFILES_FORCE_POLLING=true
