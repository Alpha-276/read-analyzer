# Optional for the RA-26 native Android Google Sign-In configuration.
# Android OAuth client (package + SHA-1) must still be configured in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Existing RA-13/RA-14 backend, used only for remote ASR/class synchronization:
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
